    llmRequestPreview: clauseCandidates.length > 0
      ? buildContractLlmPreview({
          target,
          facts,
          candidates: clauseCandidates
        })
      : null,
    errorText: ""
  };

  if (clauseCandidates.length > 0) {
    try {
      const llmSummary = await summarizeContractCandidatesWithLlm({
        target,
        facts,
        candidates: clauseCandidates
      });
      summary = {
        mode: "llm",
        statusText: "AI鎽樿",
