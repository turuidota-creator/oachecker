function reportProgress(onProgress, phase, text, detail = "") {
  if (typeof onProgress !== "function") {
    return;
  }
  try {
    onProgress({
      phase,
      text,
      detail,
      at: new Date().toISOString()
    });
  } catch {
    // Ignore progress callback errors so analysis can continue.
  }
}

